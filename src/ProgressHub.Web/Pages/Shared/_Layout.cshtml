@inject Microsoft.AspNetCore.Identity.SignInManager<ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Progress-Hub</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="navbar">
        <a class="brand" asp-page="/Index">Progress-Hub</a>
        <nav class="nav">
            @if (SignInManager.IsSignedIn(User))
            {
                var user = await UserManager.GetUserAsync(User);
                <a asp-page="/Projects/Index">Projects</a>
                <span class="muted">@(user?.DisplayName ?? User.Identity.Name)</span>
                <form asp-page="/Account/Logout" method="post" class="inline-form">
                    <button type="submit" class="link-button">Sign out</button>
                </form>
            }
            else
            {
                <a asp-page="/Account/Login">Sign in</a>
                <a asp-page="/Account/Register">Register</a>
            }
        </nav>
    </header>

    <main class="container">
        @if (TempData["Status"] != null)
        {
            <div class="alert alert-info">@TempData["Status"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>
